    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dlt645.Core</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
