<Window x:Class="Dlt645.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Dlt645.App.ViewModels"
        xmlns:views="clr-namespace:Dlt645.App.Views"
        xmlns:comm="clr-namespace:Dlt645.Core.Communication;assembly=Dlt645.Core"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="{StaticResource WindowBackBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReadCurrentPageCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ReadPageViewModel}">
            <views:ReadPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomDiPageViewModel}">
            <views:CustomDiPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriverPageViewModel}">
            <views:DriverPageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimulatorPageViewModel}">
            <views:SimulatorPageView/>
        </DataTemplate>

        <!-- 报文监视的一行 -->
        <DataTemplate x:Key="MonitorItemTemplate" DataType="{x:Type comm:MonitorEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" Foreground="#78909C" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <Border Grid.Column="1" Background="{Binding Kind, Converter={StaticResource KindToBrush}}" CornerRadius="3"
                        Padding="0,0" Margin="0,1,6,1" VerticalAlignment="Top" Height="18">
                    <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding HexText}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                               Foreground="{Binding Kind, Converter={StaticResource KindToBrush}, ConverterParameter=text}"
                               Visibility="{Binding HexText, Converter={StaticResource NotEmptyToVis}}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#455A64" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ====================== 状态栏 ====================== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="4,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding LastCommText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="160" Height="14" Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ProgressText}" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Grid.Column="2" Margin="8,2"/>
            <StatusBarItem Grid.Column="3">
                <TextBlock Text="{Binding CatalogText}" Foreground="{StaticResource MutedTextBrush}" ToolTip="{Binding LogDirectoryText}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 串口连接 -->
                <RowDefinition Height="Auto"/>   <!-- 1 表号与操作 -->
                <RowDefinition Height="Auto"/>   <!-- 2 错误提示 -->
                <RowDefinition Height="*" MinHeight="260"/>    <!-- 3 主区域 -->
                <RowDefinition x:Name="SplitterRow" Height="6"/>      <!-- 4 分隔条 -->
                <RowDefinition x:Name="MonitorRow" Height="160" MinHeight="90"/>   <!-- 5 报文监视（可收起） -->
            </Grid.RowDefinitions>

            <!-- ====================== 串口连接 ====================== -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="串口连接" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="串口" Style="{StaticResource Label}"/>
                            <ComboBox Width="330" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                                      DisplayMemberPath="Display" IsEnabled="{Binding CanEditPort}" Margin="0,0,4,0"
                                      ToolTip="标有【CH340】的为红外通讯头"/>
                            <Button Content="刷新" Command="{Binding RefreshPortsCommand}" ToolTip="重新扫描串口（插拔 USB 后也会自动刷新）"/>
                            <TextBlock Text="波特率" Style="{StaticResource Label}" Margin="8,0,6,0"/>
                            <ComboBox Width="78" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" IsEnabled="{Binding CanEditSerialParams}"/>
                            <TextBlock Text="数据位" Style="{StaticResource Label}"/>
                            <ComboBox Width="50" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" IsEnabled="{Binding CanEditSerialParams}"/>
                            <TextBlock Text="校验" Style="{StaticResource Label}"/>
                            <ComboBox Width="96" ItemsSource="{Binding ParityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Parity}" IsEnabled="{Binding CanEditSerialParams}"/>
                            <TextBlock Text="停止位" Style="{StaticResource Label}"/>
                            <ComboBox Width="50" ItemsSource="{Binding StopBitsOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding StopBits}" IsEnabled="{Binding CanEditSerialParams}"/>
                            <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" ToolTip="2400bps，8 数据位，偶校验 E，1 停止位，超时 1500ms，重试 2 次"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="超时" Style="{StaticResource Label}" Margin="76,0,6,0"/>
                            <TextBox Width="60" Text="{Binding TimeoutMs, UpdateSourceTrigger=LostFocus}" ToolTip="每次发送后等待应答的时间，200~10000ms"/>
                            <TextBlock Text="ms" Style="{StaticResource Label}" Margin="4,0,14,0"/>
                            <TextBlock Text="重试" Style="{StaticResource Label}"/>
                            <TextBox Width="40" Text="{Binding Retries, UpdateSourceTrigger=LostFocus}" ToolTip="失败后自动重发的次数，0~5"/>
                            <TextBlock Text="次" Style="{StaticResource Label}" Margin="4,0,20,0"/>
                            <CheckBox Content="模拟电表模式（不接硬件演示 / 测试）" IsChecked="{Binding UseSimulator}"
                                      IsEnabled="{Binding CanEditSerialParams}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="← 更多模拟设置与故障注入见左侧“模拟电表”页" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <DockPanel Margin="76,6,0,0" Visibility="{Binding PortHint, Converter={StaticResource NotEmptyToVis}}">
                            <Button DockPanel.Dock="Right" Content="驱动检测与安装" Command="{Binding OpenDriverPageCommand}"
                                    Style="{StaticResource DangerButton}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding PortHint}" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- 连接按钮与指示灯 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,4,0">
                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="110" MinHeight="40" FontSize="15"/>
                        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="12,6" Margin="8,0,0,0" MinWidth="170" Background="#FAFBFC">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="22" Height="22" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                         Stroke="#40000000" StrokeThickness="1" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6"
                                                          Color="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="Bold"
                                               Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                    <Border Background="#FF8F00" CornerRadius="3" Padding="6,0" HorizontalAlignment="Left" Margin="0,2,0,0"
                                            Visibility="{Binding IsSimulatorActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="模拟模式" Foreground="White" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====================== 表号与常用操作 ====================== -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,6,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="表　　号" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Margin="0,0,8,0">
                        <TextBox x:Name="AddressBox" Width="190" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" MaxLength="12"
                                 Text="{Binding MeterAddressText, UpdateSourceTrigger=PropertyChanged}" LostFocus="AddressBox_LostFocus"
                                 ToolTip="12 位表号；不足 12 位自动左补 0；AAAAAAAAAAAA 为公共地址"/>
                    </StackPanel>
                    <Button Content="读取表号" Command="{Binding ReadAddressCommand}" ToolTip="用公共地址发送读通信地址命令（13H），成功后自动填入"/>
                    <Button Content="重置为公共表号" Command="{Binding ResetAddressCommand}"/>
                    <Rectangle Width="1" Fill="{StaticResource CardBorderBrush}" Margin="6,2,12,2"/>
                    <Button Content="一键读取常用数据" Command="{Binding ReadCommonCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140"/>
                    <Button Content="取消读取 (Esc)" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Width="1" Fill="{StaticResource CardBorderBrush}" Margin="6,2,12,2"/>
                    <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" ToolTip="导出当前页面的读取结果"/>
                    <Button Content="导出 Excel" Command="{Binding ExportExcelCommand}" ToolTip="导出当前页面的读取结果"/>
                    <TextBlock Text="{Binding AddressError}" Foreground="#C62828" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding AddressError, Converter={StaticResource NotEmptyToVis}}"/>
                </WrapPanel>
            </Border>

            <!-- ====================== 错误提示条 ====================== -->
            <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="4" BorderThickness="1" Padding="12,8"
                    Visibility="{Binding CurrentError, Converter={StaticResource NotEmptyToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FDECEA"/>
                        <Setter Property="BorderBrush" Value="#EF9A9A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentError.IsWarning}" Value="True">
                                <Setter Property="Background" Value="#FFF4E5"/>
                                <Setter Property="BorderBrush" Value="#FFCC80"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding CurrentError.Headline}" FontWeight="Bold" FontSize="15" Foreground="#B71C1C"/>
                        <TextBlock Text="{Binding CurrentError.Detail}" Margin="12,1,0,0" Foreground="#5D4037" TextWrapping="Wrap" MaxWidth="760"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="可能原因" FontWeight="SemiBold" Foreground="#6D4C41"/>
                        <TextBlock Text="{Binding CurrentError.Causes}" TextWrapping="Wrap" Foreground="#4E342E"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="排查建议" FontWeight="SemiBold" Foreground="#1B5E20"/>
                        <TextBlock Text="{Binding CurrentError.Suggestions}" TextWrapping="Wrap" Foreground="#1B5E20"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top">
                        <Button Content="复制" Command="{Binding CopyErrorCommand}" Margin="0,0,0,4" ToolTip="复制错误信息，发给工程师"/>
                        <Button Content="关闭" Command="{Binding DismissErrorCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====================== 主区域：左侧菜单 + 功能页 ====================== -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0,6">
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="4,0,0,0" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                               VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="10,8">
                    <ContentControl Content="{Binding SelectedPage}" Focusable="False"/>
                </Border>
            </Grid>

            <GridSplitter x:Name="MonitorSplitter" Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4"
                          Background="#CFD8DC" ResizeDirection="Rows" ShowsPreview="False" ToolTip="拖动调整报文窗口高度"/>

            <!-- ====================== 报文监视 ====================== -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="8,6">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="报文监视" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,14,0">
                            <Run Text="■ 发送" Foreground="#1E88E5"/>
                            <Run Text="  ■ 接收" Foreground="#2E7D32"/>
                            <Run Text="  ■ 回显(已过滤)" Foreground="#9E9E9E"/>
                            <Run Text="  ■ 错误" Foreground="#D32F2F"/>
                        </TextBlock>
                        <Button Content="复制全部" Command="{Binding CopyMonitorCommand}" ToolTip="选中若干行后按 Ctrl+C 可只复制选中的"/>
                        <Button Content="清空" Command="{Binding ClearMonitorCommand}"/>
                        <Button Content="导出 TXT" Command="{Binding ExportMonitorCommand}"/>
                        <Button Content="导出诊断信息" Command="{Binding ExportDiagnosticsCommand}"
                                ToolTip="打包软件版本、串口参数、最近报文和错误日志，发给工程师"/>
                        <CheckBox Content="自动滚动" IsChecked="{Binding AutoScrollMonitor}" Margin="8,0,12,0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="MonitorToggle" Padding="10,3" MinHeight="26" Cursor="Hand"
                                      Checked="MonitorToggle_Changed" Unchecked="MonitorToggle_Changed"
                                      ToolTip="收起报文窗口，给上方结果表格更多空间">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="收起报文 ▼"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="展开报文 ▲"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </WrapPanel>
                    <ListBox x:Name="MonitorList" ItemsSource="{Binding MonitorEntries}" ItemTemplate="{StaticResource MonitorItemTemplate}"
                             SelectionMode="Extended" BorderBrush="{StaticResource CardBorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="MonitorCopy_Executed"/>
                        </ListBox.CommandBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
