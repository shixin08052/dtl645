<UserControl x:Class="Dlt645.App.Views.ReadPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dlt645.App.Views"
             x:Name="Root" SizeChanged="Root_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel x:Name="HeaderPanel" Margin="0,0,0,6">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#263238"/>
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 选择区 -->
        <!-- 选择区：高度随页面自动限制，始终给结果表格留出空间；读取后自动收起 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FAFCFE" Padding="8,6"
                Visibility="{Binding IsSelectorExpanded, Converter={StaticResource BoolToVis}}">
            <ScrollViewer x:Name="SelectionScroll" VerticalScrollBarVisibility="Auto" MaxHeight="290">
                <StackPanel>
                    <!-- 数据项 -->
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="数据项" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="全选" Command="{Binding SelectAllCommand}" Padding="8,1" MinHeight="24"/>
                        <Button Content="全不选" Command="{Binding SelectNoneCommand}" Padding="8,1" MinHeight="24"/>
                        <TextBlock Text="（鼠标悬停可查看数据标识和格式）" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ItemsView}" Focusable="False">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                                   VerticalAlignment="Top" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <ItemsPresenter Grid.Column="1"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Tooltip}"
                                          MinWidth="170" Margin="0,3,10,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 费率 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowTariffs, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="费率" FontWeight="Bold" Width="96" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding TariffOptions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource ChipCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="全部费率" Command="{Binding TariffsAllCommand}" Padding="8,1" MinHeight="24" Margin="6,0,6,0"/>
                        <TextBlock Text="费率 1~4 依次对应 尖/峰/平/谷（DI1=00~04）" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 月份选择器 -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding ShowMonths, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="月份" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="(DI0=00~0C)" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding MonthOptions}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource ChipCheckBox}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Content="全选 13 个" Command="{Binding MonthsAllCommand}" Padding="8,1" MinHeight="24"/>
                                <Button Content="仅当前" Command="{Binding MonthsCurrentCommand}" Padding="8,1" MinHeight="24"/>
                                <Button Content="清空" Command="{Binding MonthsNoneCommand}" Padding="8,1" MinHeight="24"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 最近 N 次 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowTimes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="记录次数" FontWeight="Bold" Width="96" VerticalAlignment="Center"/>
                        <TextBlock Text="读取最近" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding TimesOptions}" SelectedItem="{Binding SelectedTimes}" Width="64"/>
                        <TextBlock Text="次记录（上1次~上N次，DI0=01~N；次数类数据只读一次）" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <!-- 自动刷新 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding SupportsAutoRefresh, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="自动刷新" FontWeight="Bold" Width="96" VerticalAlignment="Center"/>
                        <CheckBox Content="开启" IsChecked="{Binding IsAutoRefresh}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="间隔" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding RefreshIntervalOptions}" SelectedItem="{Binding RefreshIntervalSeconds}" Width="60"/>
                        <TextBlock Text="秒（上一轮读完后才会开始下一轮）" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 操作栏 -->
        <DockPanel x:Name="ActionBar" Grid.Row="2" Margin="0,6">
            <Button Content="读取选中项 (F5)" Command="{Binding ReadCommand}" Style="{StaticResource PrimaryButton}" MinWidth="140" MinHeight="34" FontSize="14"/>
            <Button Content="清空结果" Command="{Binding ClearResultsCommand}"/>
            <ToggleButton IsChecked="{Binding IsSelectorExpanded}" Padding="12,5" MinHeight="30" Margin="0,0,6,0" Cursor="Hand"
                          ToolTip="收起选择区可以让结果表格显示更多行">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="展开选择区 ▼"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="收起选择区 ▲"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- 结果 -->
        <views:ResultsGrid Grid.Row="3"/>
    </Grid>
</UserControl>
