<UserControl x:Class="Dlt645.App.Views.SimulatorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#263238"/>
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

            <!-- 启动 -->
            <Border CornerRadius="4" Padding="12,10" Margin="0,0,0,8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFF8E1"/>
                        <Setter Property="BorderBrush" Value="#FFE082"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Main.IsSimulatorActive}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="BorderBrush" Value="#A5D6A7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="启动模拟电表" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="130" MinHeight="36" FontSize="14" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="模拟电表未运行。点击左侧按钮即可启动（等同于勾选上方“模拟电表模式”再点“启动模拟”）。如已打开真实串口，请先关闭。"/>
                                    <Setter Property="Foreground" Value="#8D6E63"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Main.IsSimulatorActive}" Value="True">
                                            <Setter Property="Text" Value="模拟电表运行中。下面的设置修改后立即生效；到各功能页读取即可看到效果。停止请点上方“停止模拟”。"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="演示步骤：启动 → 点“读取表号”（会读到模拟表号）→ 点“一键读取常用数据” → 在报文监视窗口查看发送 / 回显 / 接收报文"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 基本设置 -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FAFCFE" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="基本设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <TextBlock Text="模拟表号" Style="{StaticResource Label}"/>
                        <TextBox Width="150" FontFamily="Consolas" FontSize="15" MaxLength="12" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="应用表号" Command="{Binding ApplyAddressCommand}" Margin="6,0,6,0"/>
                        <TextBlock Text="{Binding AddressError}" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Visibility="{Binding AddressError, Converter={StaticResource NotEmptyToVis}}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="模拟红外回显（发出的帧会先被自己收到，演示回显过滤）" IsChecked="{Binding Echo}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <CheckBox Content="只认实际表号（读数据时不响应公共地址 AA，很多现场电表如此）" IsChecked="{Binding RejectWildcardRead}" VerticalAlignment="Center" Margin="0,0,20,0"
                                  ToolTip="勾选后，表号框为 AAAAAAAAAAAA 时软件会自动先读出实际表号再读数据"/>
                        <TextBlock Text="应答延迟" Style="{StaticResource Label}"/>
                        <TextBox Width="60" Text="{Binding ResponseDelayMs, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="ms" Style="{StaticResource Label}" Margin="4,0,20,0"/>
                        <TextBlock Text="单帧最大数据" Style="{StaticResource Label}"/>
                        <TextBox Width="50" Text="{Binding MaxDataPerFrame, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="字节（超过则用后续帧 B1H/12H 分帧，开表盖记录 60 字节即可看到效果）" Style="{StaticResource Label}" Margin="4,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 故障模拟 -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FAFCFE" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="故障模拟（演示错误提示）" Style="{StaticResource SectionTitle}"/>
                        <Button Content="全部恢复正常" Command="{Binding ResetFaultsCommand}" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <CheckBox Content="电表不应答 —— 演示 E201 超时无应答（只会收到回显），指示灯变“通讯超时”" IsChecked="{Binding NoResponse}" Margin="0,2"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="下一帧校验错误 (E202)" Command="{Binding InjectChecksumCommand}"
                                ToolTip="下一次应答的 CS 被破坏；若重试次数 ≥ 1，会自动重试成功，可在报文窗口看到错误帧和重试过程"/>
                        <Button Content="下一帧不完整 (E203)" Command="{Binding InjectTruncateCommand}"
                                ToolTip="下一次应答只发送一半；若重试次数为 0 会提示帧不完整，否则重试后恢复"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="异常应答 (E301)" Style="{StaticResource Label}"/>
                        <ComboBox Width="200" ItemsSource="{Binding ErrorWordOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedErrorWord}"/>
                        <TextBlock Text="选中后所有读数据请求都返回 D1H，并带上该错误字" Style="{StaticResource Label}" Foreground="{StaticResource MutedTextBrush}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding FaultStatus}" Foreground="#E65100" Margin="0,6,0,0"
                               Visibility="{Binding FaultStatus, Converter={StaticResource NotEmptyToVis}}"/>
                </StackPanel>
            </Border>

            <!-- 自定义应答数据 -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FAFCFE" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="自定义应答数据（测试解析逻辑）" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"
                               Text="给任意数据标识指定电表应答的数据域（不含 DI，不加 33H），然后到对应功能页或“自定义数据标识”页读取，检查解析结果。例如正向有功总电能 00010000 输入 00 00 12 34（高字节在前）即 12.34 kWh；输入 80 00 12 34 测试组合有功的负号（00000000）。"/>
                    <WrapPanel>
                        <TextBlock Text="数据标识 DI" Style="{StaticResource Label}"/>
                        <TextBox Width="110" FontFamily="Consolas" FontSize="15" Text="{Binding CustomDi, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="数据" Style="{StaticResource Label}" Margin="14,0,6,0"/>
                        <TextBox Width="300" FontFamily="Consolas" FontSize="15" Text="{Binding CustomData, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="按高字节在前输入（与读数顺序一致）" IsChecked="{Binding CustomMsbFirst}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <Button Content="设置应答数据" Command="{Binding SetCustomDataCommand}" Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding CustomPreview}" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C62828"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomPreviewOk}" Value="True">
                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel Margin="0,10,0,4">
                        <TextBlock Text="已设置的自定义数据" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="全部清除" Command="{Binding ClearCustomDataCommand}" HorizontalAlignment="Left" Padding="8,1" MinHeight="24"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CustomEntries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ECEFF1" BorderThickness="0,0,0,1" Padding="0,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="删除" Padding="8,1" MinHeight="24"
                                                Command="{Binding DataContext.RemoveCustomDataCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding DiText}" FontFamily="Consolas" FontWeight="Bold" Width="90" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DataText}" FontFamily="Consolas" Width="260" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#455A64"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
