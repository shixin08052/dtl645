<UserControl x:Class="Dlt645.App.Views.CustomDiPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dlt645.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#263238"/>
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Description}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FAFCFE" Padding="10,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="数据标识 DI" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="130" FontFamily="Consolas" FontSize="17" MaxLength="16"
                             Text="{Binding DiText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按 DI3 DI2 DI1 DI0 顺序输入 8 位十六进制，可带空格。&#x0a;常用示例：00010000 正向有功总电能 · 0201FF00 三相电压数据块 · 04000401 通信地址 · 04000101 日期 · 03110000 掉电次数">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ReadCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="格式" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox Width="190" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}"/>
                    <CheckBox Content="有符号" IsChecked="{Binding Signed}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="最高位为符号位"/>
                    <Button Content="读取 (Enter)" Command="{Binding ReadCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110" MinHeight="32"/>
                    <Button Content="清空结果" Command="{Binding ClearResultsCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding DiError}" Foreground="#C62828" Margin="0,6,0,0"
                           Visibility="{Binding DiError, Converter={StaticResource NotEmptyToVis}}"/>
                <TextBlock Text="{Binding MatchText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding MatchText, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E65100"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,6,0,0" Visibility="{Binding LastRawText, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="原始数据" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding LastRawText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Background="#F5F7F9"
                     ToolTip="可选中复制"/>
        </DockPanel>

        <views:ResultsGrid Grid.Row="3" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
